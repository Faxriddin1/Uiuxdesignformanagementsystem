# =============================================================================
# Management System Backend - Environment Configuration
# =============================================================================
# Скопируйте этот файл как .env и настройте значения
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------

# Режим отладки (НИКОГДА не включать в production!)
DEBUG=True

# Окружение: development | staging | production
DJANGO_ENV=development

# Секретный ключ Django (в production используйте надежный случайный ключ!)
# Генерация: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-change-in-production-abc123xyz789

# Разрешенные хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Для Docker Compose используйте имя сервиса 'db'
DATABASE_URL=postgres://postgres:postgres@db:5432/management_system

# Альтернативные отдельные переменные (если не используется DATABASE_URL)
DB_NAME=management_system
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------

# Разрешенные origins для фронтенда (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Разрешить credentials (cookies, auth headers)
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------------------
# JWT Authentication (Simple JWT)
# -----------------------------------------------------------------------------

# Время жизни Access токена (в минутах)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Время жизни Refresh токена (в днях)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Алгоритм подписи
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------

# Rate Limiting (запросов в минуту)
RATE_LIMIT_ANON=100
RATE_LIMIT_USER=1000

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# SSL (включить в production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------

# Максимальный размер загружаемого файла (в МБ)
MAX_UPLOAD_SIZE_MB=50

# Разрешенные типы файлов (через запятую)
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif,zip,rar

# Путь для хранения медиафайлов (относительно BASE_DIR)
MEDIA_ROOT=media

# -----------------------------------------------------------------------------
# Email Settings (для production)
# -----------------------------------------------------------------------------

# Бэкенд: console (dev) | smtp (production)
EMAIL_BACKEND=console

# SMTP настройки (если EMAIL_BACKEND=smtp)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Management System <noreply@example.com>

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Логирование SQL запросов (только для отладки!)
LOG_SQL_QUERIES=False

# -----------------------------------------------------------------------------
# Redis (для кэширования и Celery, P1 feature)
# -----------------------------------------------------------------------------

# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1

# -----------------------------------------------------------------------------
# S3/MinIO Storage (P1 feature)
# -----------------------------------------------------------------------------

# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=  # Для MinIO

# -----------------------------------------------------------------------------
# Sentry (Error Tracking, production)
# -----------------------------------------------------------------------------

# SENTRY_DSN=

# -----------------------------------------------------------------------------
# Docker Compose Settings
# -----------------------------------------------------------------------------

# Внешний порт для PostgreSQL
DB_PORT_EXTERNAL=5432

# Порт для Django приложения
WEB_PORT=8000

# -----------------------------------------------------------------------------
# Seed Data
# -----------------------------------------------------------------------------

# Создать демо-данные при первом запуске
CREATE_SEED_DATA=True

# Пароль для демо-пользователей
DEMO_USER_PASSWORD=user123
DEMO_ADMIN_PASSWORD=admin123
