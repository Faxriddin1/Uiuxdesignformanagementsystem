# =============================================================================
# Dockerfile для Management System Frontend
# =============================================================================
# Multi-stage build для оптимизации размера образа
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base image с Node.js
# -----------------------------------------------------------------------------
FROM node:20-alpine as base

# Рабочая директория
WORKDIR /app

# Установка системных зависимостей (если нужны)
RUN apk add --no-cache \
    curl

# -----------------------------------------------------------------------------
# Stage 2: Development
# -----------------------------------------------------------------------------
FROM base as development

# Копируем package files
COPY package*.json ./

# Устанавливаем зависимости
RUN npm ci

# Копируем остальной код
COPY . .

# Порт Vite dev server
EXPOSE 5173

# Healthcheck для dev server
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5173/ || exit 1

# Запуск dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# -----------------------------------------------------------------------------
# Stage 3: Build (для production)
# -----------------------------------------------------------------------------
FROM base as build

# Копируем package files
COPY package*.json ./

# Устанавливаем зависимости
RUN npm ci

# Копируем остальной код
COPY . .

# Сборка приложения
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 4: Production
# -----------------------------------------------------------------------------
FROM nginx:alpine as production

# Копируем собранные файлы
COPY --from=build /app/build /usr/share/nginx/html

# Копируем конфигурацию nginx (если есть)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Порт nginx
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Запуск nginx
CMD ["nginx", "-g", "daemon off;"]
